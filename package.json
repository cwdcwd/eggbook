{
  "name": "eggbook",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && npm run copy-sw && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate && npm run copy-sw",
    "db:migrate": "prisma migrate deploy",
    "copy-sw": "node scripts/copy-sw.mjs",
    "db:seed": "tsx scripts/seed.ts",
    "db:cleanup": "tsx scripts/cleanup.ts",
    "db:cleanup:dry": "tsx scripts/cleanup.ts --dry-run",
    "db:reset": "tsx scripts/cleanup.ts --force && tsx scripts/seed.ts",
    "test": "node --import tsx --test scripts/payment-integrity-tests.ts scripts/order-integrity-tests.ts scripts/listing-policy-tests.ts scripts/clerk-user-lifecycle-tests.ts",
    "test:security": "tsx scripts/security-tests.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.20",
    "@neondatabase/serverless": "1.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@pusher/push-notifications-server": "1.2.7",
    "@pusher/push-notifications-web": "1.1.0",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "@vercel/blob": "2.8.2",
    "@vercel/postgres": "0.10.0",
    "clsx": "2.1.1",
    "leaflet": "1.9.4",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "pusher": "5.3.4",
    "pusher-js": "8.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "23.0.1",
    "svix": "1.99.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
