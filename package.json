{
  "name": "eggbook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && npm run copy-sw && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate && npm run copy-sw",
    "db:migrate": "prisma migrate deploy",
    "copy-sw": "node scripts/copy-sw.mjs",
    "db:seed": "tsx scripts/seed.ts",
    "db:cleanup": "tsx scripts/cleanup.ts",
    "db:cleanup:dry": "tsx scripts/cleanup.ts --dry-run",
    "db:reset": "tsx scripts/cleanup.ts --force && tsx scripts/seed.ts",
    "test": "node --import tsx --test scripts/payment-integrity-tests.ts scripts/order-integrity-tests.ts scripts/listing-policy-tests.ts scripts/clerk-user-lifecycle-tests.ts",
    "test:security": "tsx scripts/security-tests.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.0.7",
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@pusher/push-notifications-server": "^1.2.7",
    "@pusher/push-notifications-web": "^1.1.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2.8.2",
    "@vercel/postgres": "^0.10.0",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.7.0",
    "next": "^16.4.2",
    "pg": "^8.20.0",
    "prisma": "^7.6.0",
    "pusher": "^5.3.3",
    "pusher-js": "^8.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^23.0.0",
    "svix": "^1.89.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.19.37",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
